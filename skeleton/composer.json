{
    "name": "evolvephp/skeleton",
    "description": "Application skeleton for EvolvePHP 2.",
    "type": "project",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.4",
        "evolvephp/contracts": "^2.0",
        "evolvephp/core": "^2.0",
        "evolvephp/http": "^2.0",
        "evolvephp/module": "^2.0",
        "evolvephp/plugin": "^2.0"
    },
    "require-dev": {
        "evolvephp/dev-tools": "^2.0",
        "evolvephp/testing": "^2.0",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
